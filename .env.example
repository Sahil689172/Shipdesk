# ================================================================
# ShipDesk Environment Variables
# ================================================================
# Copy this file to .env and fill in your values.
# Never commit the real .env file to git.

# --- Switch Server ---
SWITCH_API_URL=http://localhost:8080/api
SWITCH_API_KEY=
SWITCH_ROOM_ID=shipdesk-client-project

# --- LLM (for Intake Agent) ---
# Any OpenAI-compatible chat completion endpoint
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- GitHub (for Deploy Agent — merge-only scoped token) ---
GITHUB_TOKEN=
GITHUB_REPO=Sahil689172/Shipdesk

# --- Cloudflare Pages (for Deploy Agent — deployment monitoring) ---
CLOUDFLARE_API_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PROJECT_NAME=shipdesk-festivekart

# --- Authenticated Client IDs ---
# Comma-separated list of Discord/Switch user IDs authorised to approve
# Example: user123456,admin789012
AUTHENTICATED_CLIENT_IDS=

# --- Discord Bridge (Phase 5) ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
