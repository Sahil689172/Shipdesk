# ============================================================
# Shipdesk / FestiveKart - .gitignore
# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment variables and secrets
.env
.env.*
!.env.example

# Build output
/dist/
/build/
/.next/
/out/

# OS-generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# Editor and IDE files
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
*.bak
*.orig

# ============================================================
# IMPORTANT:
# Do NOT ignore:
# shipdesk-festivekart/assets/
# *.png, *.jpg, *.jpeg, *.webp, *.svg, *.gif
# All website assets must be committed to GitHub.
# ============================================================